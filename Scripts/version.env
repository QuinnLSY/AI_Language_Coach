# 版本号唯一来源。
#
# 谁在用：
#   - Scripts/make_app.sh  → 写进 .app/Contents/Info.plist 的 CFBundleShortVersionString / CFBundleVersion
#   - 应用内「关于」行      → 读 Bundle.main 的 Info.plist 展示（Sources/AppCore/AppVersion.swift）
#
# ⚠️ 以前版本号硬编码在 make_app.sh 里（0.4.0），与对外宣称的 v1.0 不一致。
#    改版本只动这里一处。

# 对外版本号（语义化：主.次.修订）
MARKETING_VERSION=1.1.0
# 构建号（每次打包单调递增，整数）
BUILD_VERSION=2
